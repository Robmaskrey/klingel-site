---
// Faint topographic contour lines behind the hero, like a trail map.
// Generated at build time from a little wobbly-circle math.
const rings = (cx: number, cy: number, count: number, seed: number) => {
  const paths: string[] = [];
  for (let i = 0; i < count; i++) {
    const r = 34 + i * 42;
    const s = seed + i * 0.18; // each ring drifts a bit, like real contours
    const pts: string[] = [];
    const N = 96;
    for (let j = 0; j < N; j++) {
      const a = (j / N) * Math.PI * 2;
      const k =
        1 + 0.13 * Math.sin(3 * a + s) + 0.07 * Math.sin(5 * a + s * 1.7) + 0.035 * Math.sin(9 * a + s * 0.6);
      pts.push(`${(cx + Math.cos(a) * r * k * 1.3).toFixed(1)} ${(cy + Math.sin(a) * r * k * 0.85).toFixed(1)}`);
    }
    paths.push(`M${pts.join(' L')}Z`);
  }
  return paths;
};
const paths = [...rings(1150, 250, 11, 1), ...rings(130, 90, 7, 2.4), ...rings(640, 760, 6, 4.1)];
---
<svg class="topo" viewBox="0 0 1440 800" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
  {paths.map((d) => <path d={d} />)}
</svg>
