---
import { site } from '../data/site';
import Draft from './Draft.astro';
import Logo from './Logo.astro';
const year = new Date().getFullYear();
const { email, phone, address } = site.contact;
const hasSocial = Boolean(site.social.facebook || site.social.instagram);
---
<footer>
  <div class="wrap">
    <div class="foot-grid">
      <div>
        <Logo />
        <p>{site.candidate} for {site.office}.</p>
        {hasSocial && (
          <div class="social">
            {site.social.facebook && (
              <a href={site.social.facebook} aria-label="Facebook" target="_blank" rel="noopener"><svg viewBox="0 0 24 24"><path d="M14 8h3V4h-3c-2.8 0-4 1.8-4 4.3V10H7v4h3v8h4v-8h3l1-4h-4V8.6c0-.4.3-.6.6-.6z" /></svg></a>
            )}
            {site.social.instagram && (
              <a href={site.social.instagram} aria-label="Instagram" target="_blank" rel="noopener"><svg viewBox="0 0 24 24"><path d="M12 7a5 5 0 1 0 0 10 5 5 0 0 0 0-10zm0 8a3 3 0 1 1 0-6 3 3 0 0 1 0 6zm5.2-8.4a1.2 1.2 0 1 1-2.4 0 1.2 1.2 0 0 1 2.4 0zM12 4c2.2 0 2.4 0 3.3.1 2.2.1 3.2 1.1 3.3 3.3.1.9.1 1.1.1 3.3v2.6c0 2.2 0 2.4-.1 3.3-.1 2.2-1.1 3.2-3.3 3.3-.9.1-1.1.1-3.3.1H9.7c-2.2 0-2.4 0-3.3-.1-2.2-.1-3.2-1.1-3.3-3.3C3 15.7 3 15.5 3 13.3v-2.6c0-2.2 0-2.4.1-3.3.1-2.2 1.1-3.2 3.3-3.3C7.3 4 7.5 4 9.7 4z" /></svg></a>
            )}
          </div>
        )}
      </div>
      <div>
        <h4>Explore</h4>
        <ul>
          <li><a href="#about">About Derek</a></li>
          <li><a href="#priorities">Priorities</a></li>
          <li><a href="#events">Events</a></li>
          <li><a href="#donate">Donate</a></li>
        </ul>
      </div>
      <div>
        <h4>Contact</h4>
        <ul>
          <li>{email ? <a href={`mailto:${email}`}>{email}</a> : <Draft>Campaign email</Draft>}</li>
          <li>{phone ? <a href={`tel:${phone.replace(/[^\d+]/g, '')}`}>{phone}</a> : <Draft>Campaign phone</Draft>}</li>
          <li>{address ? address : <Draft>Mailing address</Draft>}</li>
        </ul>
      </div>
    </div>
    <div class="paid-for">Paid for by {site.committee}</div>
    <div class="copyright">&copy; {year} {site.committee}. All rights reserved.</div>
  </div>
</footer>
