---
import type { IconName } from '../data/site';
interface Props { name: IconName }
const { name } = Astro.props;
---
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === 'road' && <path d="M4 20 L10 4 M20 20 L14 4 M12 6v2 M12 11v2 M12 16v2" />}
  {name === 'mountain' && <><path d="M3 20h18 M6 20l5-9 3 5 2-3 4 7" /><circle cx="17" cy="6" r="2" /></>}
  {name === 'house' && <path d="M3 11l9-7 9 7 M5 10v10h14V10 M10 20v-5h4v5" />}
  {name === 'pin' && <><path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21z" /><circle cx="12" cy="9.5" r="2.5" /></>}
  {name === 'people' && <><circle cx="9" cy="8" r="3" /><circle cx="17" cy="9" r="2.5" /><path d="M3 20c0-3.3 2.7-6 6-6s6 2.7 6 6 M15 14.5c3 0 6 2 6 5.5" /></>}
  {name === 'shield' && <path d="M12 3l8 4v5c0 5-3.5 8-8 9-4.5-1-8-4-8-9V7z" />}
  {name === 'movie' && <><rect x="3" y="5" width="18" height="14" rx="2" /><path d="M7 5v14 M17 5v14 M3 9.5h4 M3 14.5h4 M17 9.5h4 M17 14.5h4" /></>}
  {name === 'gamepad' && <><path d="M6.5 8h11a4.5 4.5 0 0 1 4.5 4.5v.5a3 3 0 0 1-5.4 1.8L15 13H9l-1.6 1.8A3 3 0 0 1 2 13v-.5A4.5 4.5 0 0 1 6.5 8z" /><path d="M7 10v3 M5.5 11.5h3 M15.5 10.5h.01 M17.5 12h.01" /></>}
  {name === 'golf' && <path d="M9 20V3l8 3.5L9 10 M4.5 20.5c1.5-.7 3-1 4.5-1s3 .3 4.5 1" />}
  {name === 'kitchen' && <path d="M7 3v18 M4.5 3v5a2.5 2.5 0 0 0 5 0V3 M17 21V3c-2.2 1.6-3 4.4-3 7.5 0 1.4 1.3 2.5 3 2.5" />}
  {name === 'paw' && <><circle cx="8" cy="7.5" r="1.7" /><circle cx="16" cy="7.5" r="1.7" /><circle cx="4.8" cy="12" r="1.5" /><circle cx="19.2" cy="12" r="1.5" /><path d="M12 11.5c-2.6 0-5 3.6-5 5.7 0 1.6 1.4 2.6 3 2.1 1-.3 1.4-.5 2-.5s1 .2 2 .5c1.6.5 3-.5 3-2.1 0-2.1-2.4-5.7-5-5.7z" /></>}
</svg>
