---
// Campaign logo: "Klingel" wordmark + gold-checked ballot box.
import { site } from '../data/site';
---
<a href="#top" class="logo" aria-label={`${site.candidate}, back to top`}>
  {site.lastName}
  <svg class="logo-check" viewBox="0 0 22 22" aria-hidden="true">
    <rect x="1" y="1" width="20" height="20" rx="4" fill="none" stroke="#fff" stroke-width="2" />
    <path d="M5.5 11.5 L9.5 15.5 L17 6.5" pathLength="1" fill="none" stroke="#f2b84b" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
</a>
